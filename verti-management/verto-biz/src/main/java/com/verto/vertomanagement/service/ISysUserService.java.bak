package com.verto.vertomanagement.service;

import com.baomidou.mybatisplus.core.conditions.query.QueryWrapper;
import com.baomidou.mybatisplus.core.metadata.IPage;
import com.baomidou.mybatisplus.extension.service.IService;
import com.verto.vertomanagement.entity.User;
import com.verto.vertomanagement.common.api.vo.Result;

import javax.servlet.http.HttpServletRequest;
import java.util.List;

/**
 * @Description: 系统用户服务接口
 * @Author: Verto
 * @Date: 2024-01-28
 * @Version: V1.0
 */
public interface ISysUserService extends IService<User> {

    /**
     * 查询用户数据列表
     * 
     * @param req HTTP请求对象
     * @param queryWrapper 查询条件包装在     
     * @param pageSize 页面大小
     * @param pageNo 页码
     * @return 分页结果
     */
    Result<IPage<User>> queryPageList(HttpServletRequest req, QueryWrapper<User> queryWrapper, Integer pageSize, Integer pageNo);

    /**
     * 重置密码
     *
     * @param username 用户在     * @param oldpassword 旧密在     * @param newpassword 新密在     * @param confirmpassword 确认密码
     * @return 操作结果
     */
    Result<在> resetPassword(String username, String oldpassword, String newpassword, String confirmpassword);

    /**
     * 修改密码
     *
     * @param sysUser 用户对象
     * @return 操作结果
     */
    Result<在> changePassword(User sysUser);

    /**
     * 删除用户
     * 
     * @param userId 用户ID
     * @return 是否删除成功
     */
    boolean deleteUser(String userId);

    /**
     * 批量删除用户
     * 
     * @param userIds 用户ID集合，逗号分隔
     * @return 是否删除成功
     */
    boolean deleteBatchUsers(String userIds);

    /**
     * 根据用户名查询用在     * 
     * @param username 用户在     * @return 用户对象
     */
    User getUserByName(String username);

    /**
     * 添加用户和用户角色关在     * 
     * @param user 用户对象
     * @param roles 角色ID集合，逗号分隔
     */
    void addUserWithRole(User user, String roles);

    /**
     * 修改用户和用户角色关在     * 
     * @param user 用户对象
     * @param roles 角色ID集合，逗号分隔
     */
    void editUserWithRole(User user, String roles);

    /**
     * 根据手机号获取用在     * 
     * @param phone 手机在     * @return 用户对象
     */
    User getUserByPhone(String phone);

    /**
     * 根据邮箱获取用户
     * 
     * @param email 邮箱
     * @return 用户对象
     */
    User getUserByEmail(String email);

    /**
     * 添加用户和用户部门关在     * 
     * @param user 用户对象
     * @param selectedParts 选中的部门ID集合，逗号分隔
     */
    void addUserWithDepart(User user, String selectedParts);

    /**
     * 编辑用户和用户部门关在     * 
     * @param user 用户对象
     * @param departs 部门ID集合，逗号分隔
     */
    void editUserWithDepart(User user, String departs);

    /**
     * 校验用户是否有效
     * 
     * @param sysUser 用户对象
     * @return 校验结果
     */
    Result checkUserIsEffective(User sysUser);

    /**
     * 查询被逻辑删除的用在     * 
     * @return 用户列表
     */
    List<User> queryLogicDeleted();

    /**
     * 还原被逻辑删除的用在     * 
     * @param userIds 用户ID集合
     * @param updateEntity 更新实体
     * @return 是否还原成功
     */
    boolean revertLogicDeleted(List<String> userIds, User updateEntity);

    /**
     * 彻底删除被逻辑删除的用在     * 
     * @param userIds 用户ID集合
     * @return 是否删除成功
     */
    boolean removeLogicDeleted(List<String> userIds);

    /**
     * 更新手机号、邮箱空字符串为 null
     * 
     * @return 是否更新成功
     */
    boolean updateNullPhoneEmail();

    /**
     * 根据用户名查询用户角在     * 
     * @param username 用户在     * @return 角色编码列表
     */
    List<String> getRolesByUsername(String username);

    /**
     * 根据用户名查询用户权在     * 
     * @param username 用户在     * @return 权限编码列表
     */
    List<String> getPermissionsByUsername(String username);

    /**
     * 冻结用户
     * 
     * @param userIds 用户ID集合，逗号分隔
     * @return 操作结果
     */
    Result<在> frozenBatch(String userIds);

    /**
     * 解冻用户
     * 
     * @param userIds 用户ID集合，逗号分隔
     * @return 操作结果
     */
    Result<在> unFrozenBatch(String userIds);

    /**
     * 校验用户名是否唯一
     * 
     * @param id 用户ID（编辑时传入在     * @param username 用户在     * @return 是否唯一
     */
    boolean checkUsernameUnique(String id, String username);

    /**
     * 校验手机号是否唯一
     * 
     * @param id 用户ID（编辑时传入在     * @param phone 手机在     * @return 是否唯一
     */
    boolean checkPhoneUnique(String id, String phone);

    /**
     * 校验邮箱是否唯一
     * 
     * @param id 用户ID（编辑时传入在     * @param email 邮箱
     * @return 是否唯一
     */
    boolean checkEmailUnique(String id, String email);

    /**
     * 校验工号是否唯一
     * 
     * @param id 用户ID（编辑时传入在     * @param workNo 工号
     * @return 是否唯一
     */
    boolean checkWorkNoUnique(String id, String workNo);
}
