package com.verto.vertomanagement.service.impl;

import com.baomidou.mybatisplus.core.conditions.query.LambdaQueryWrapper;
import com.baomidou.mybatisplus.extension.service.impl.ServiceImpl;
import com.verto.vertomanagement.entity.SysDict;
import com.verto.vertomanagement.entity.SysDictItem;
import com.verto.vertomanagement.mapper.SysDictMapper;
import com.verto.vertomanagement.service.ISysDictItemService;
import com.verto.vertomanagement.service.ISysDictService;
import com.verto.vertomanagement.vo.DictModel;
import com.verto.vertomanagement.vo.DictQuery;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.util.StringUtils;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * 系统字典服务实现在 * 实现字典数据的业务逻辑处理
 * 
 * @author Verto
 * @since 2024-01-01
 */
@Service
@Slf4j
public class SysDictServiceImpl extends ServiceImpl<SysDictMapper, SysDict> implements ISysDictService {

    @Autowired
    private SysDictMapper sysDictMapper;

    @Autowired
    private ISysDictItemService sysDictItemService;

    /**
     * 通过字典编码查询字典在     * @param code 字典编码
     * @return 字典项列在     */
    @Override
    public List<DictModel> queryDictItemsByCode(String code) {
        log.debug("查询字典项，字典编码：{}", code);
        return sysDictMapper.queryDictItemsByCode(code);
    }

    /**
     * 查询有效的字典项
     * @param code 字典编码
     * @return 有效的字典项列表
     */
    @Override
    public List<DictModel> queryEnableDictItemsByCode(String code) {
        log.debug("查询有效字典项，字典编码：{}", code);
        return sysDictMapper.queryEnableDictItemsByCode(code);
    }

    /**
     * 通过字典编码和键值获取字典文在     * @param code 字典编码
     * @param key 字典键在     * @return 字典文本
     */
    @Override
    public String queryDictTextByKey(String code, String key) {
        log.debug("查询字典文本，字典编码：{}，键值：{}", code, key);
        return sysDictMapper.queryDictTextByKey(code, key);
    }

    /**
     * 查询所有字典项
     * @return 所有字典项
     */
    @Override
    public Map<String, List<DictModel>> queryAllDictItems() {
        log.debug("查询所有字典项");
        List<DictModel> list = sysDictMapper.queryAllDictItems();
        Map<String, List<DictModel>> res = new HashMap<>();
        for (DictModel model : list) {
            String dictCode = model.getValue();
            if (res.containsKey(dictCode)) {
                res.get(dictCode).add(model);
            } else {
                List<DictModel> ls = new ArrayList<>();
                ls.add(model);
                res.put(dictCode, ls);
            }
        }
        return res;
    }

    /**
     * 查询所有部门字在     * @return 部门字典列表
     */
    @Override
    public List<DictModel> queryAllDepartBackDictModel() {
        log.debug("查询所有部门字在");
        return sysDictMapper.queryAllDepartBackDictModel();
    }

    /**
     * 查询所有用户字在     * @return 用户字典列表
     */
    @Override
    public List<DictModel> queryAllUserBackDictModel() {
        log.debug("查询所有用户字在");
        return sysDictMapper.queryAllUserBackDictModel();
    }

    /**
     * 查询表字典项（支持过滤条件）
     * @param table 表名
     * @param text 文本字段
     * @param code 编码字段
     * @param filterSql 过滤SQL
     * @return 字典项列在     */
    @Override
    public List<DictModel> queryTableDictItemsByCodeAndFilter(String table, String text, String code, String filterSql) {
        log.debug("查询表字典项，表名：{}，文本字段：{}，编码字段：{}，过滤条件：{}", table, text, code, filterSql);
        return sysDictMapper.queryTableDictItemsByCodeAndFilter(table, text, code, filterSql);
    }

    /**
     * 删除字典（物理删除）
     * @param id 字典ID
     */
    @Override
    @Transactional(rollbackFor = Exception.class)
    public void deleteOneDictPhysically(String id) {
        log.info("物理删除字典，ID：{}", id);
        // 删除字典在        sysDictItemService.deleteByDictId(id);
        // 删除字典
        this.removeById(id);
    }

    /**
     * 更新字典删除标志
     * @param delFlag 删除标志
     * @param id 字典ID
     */
    @Override
    public void updateDictDelFlag(int delFlag, String id) {
        log.info("更新字典删除标志，ID：{}，删除标志：{}", id, delFlag);
        sysDictMapper.updateDictDelFlag(delFlag, id);
    }

    /**
     * 刷新字典缓存
     */
    @Override
    public void refreshCache() {
        log.info("刷新字典缓存");
        // TODO: 实现缓存刷新逻辑
    }

    /**
     * 根据字典编码删除Redis缓存
     * @param dictCode 字典编码
     */
    @Override
    public void deleteByDictCode(String dictCode) {
        log.info("删除字典缓存，字典编码：{}", dictCode);
        // TODO: 实现缓存删除逻辑
    }

    /**
     * 查询删除列表
     * @return 已删除的字典列表
     */
    @Override
    public List<SysDict> queryDeleteList() {
        log.debug("查询已删除的字典列表");
        LambdaQueryWrapper<SysDict> queryWrapper = new LambdaQueryWrapper<>();
        queryWrapper.eq(SysDict::getDelFlag, 1);
        return this.list(queryWrapper);
    }

    /**
     * 还原逻辑删除的数在     * @param ids ID列表
     */
    @Override
    @Transactional(rollbackFor = Exception.class)
    public void revertLogicDeleted(List<String> ids) {
        log.info("还原逻辑删除的字典，IDs：{}", ids);
        for (String id : ids) {
            this.updateDictDelFlag(0, id);
        }
    }

    /**
     * 彻底删除逻辑删除的数在     * @param ids ID列表
     */
    @Override
    @Transactional(rollbackFor = Exception.class)
    public void removeLogicDeleted(List<String> ids) {
        log.info("彻底删除逻辑删除的字典，IDs：{}", ids);
        for (String id : ids) {
            this.deleteOneDictPhysically(id);
        }
    }

    /**
     * 保存字典及其子项
     * @param sysDict 字典对象
     * @param sysDictItemList 字典项列在     */
    @Override
    @Transactional(rollbackFor = Exception.class)
    public void saveDict(SysDict sysDict, List<SysDictItem> sysDictItemList) {
        log.info("保存字典及其子项，字典编码：{}", sysDict.getDictCode());
        // 保存字典
        this.save(sysDict);
        // 保存字典在        
        if (sysDictItemList != null && !sysDictItemList.isEmpty()) {
            sysDictItemService.saveBatch(sysDict.getId(), sysDictItemList);
        }
    }

    /**
     * 更新字典及其子项
     * @param sysDict 字典对象
     * @param sysDictItemList 字典项列在     */
    @Override
    @Transactional(rollbackFor = Exception.class)
    public void updateDict(SysDict sysDict, List<SysDictItem> sysDictItemList) {
        log.info("更新字典及其子项，字典编码：{}", sysDict.getDictCode());
        // 更新字典
        this.updateById(sysDict);
        // 删除原有字典在        
        sysDictItemService.deleteByDictId(sysDict.getId());
        // 保存新的字典在        
        if (sysDictItemList != null && !sysDictItemList.isEmpty()) {
            sysDictItemService.saveBatch(sysDict.getId(), sysDictItemList);
        }
    }
}
