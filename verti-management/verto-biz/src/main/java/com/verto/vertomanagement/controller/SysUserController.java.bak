package com.verto.vertomanagement.controller;

import com.baomidou.mybatisplus.core.conditions.query.QueryWrapper;
import com.baomidou.mybatisplus.core.metadata.IPage;
import com.baomidou.mybatisplus.extension.plugins.pagination.Page;
import com.verto.vertomanagement.common.Result;
import com.verto.vertomanagement.entity.User;
import com.verto.vertomanagement.service.ISysUserService;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.servlet.ModelAndView;

import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import java.io.IOException;
import java.util.Arrays;
import java.util.List;

/**
 * 系统用户管理控制器
 * 
 * @author Verto
 * @since 2024-01-01
 */
@Tag(name = "系统用户管理", description = "系统用户管理相关接口")
@RestController
@RequestMapping("/system/user")
@Slf4j
public class SysUserController {

    @Autowired
    private ISysUserService sysUserService;

    /**
     * 分页查询用户列表
     *
     * @param user 用户查询条件
     * @param pageNo 页码
     * @param pageSize 页面大小
     * @param req HTTP请求对象
     * @return 分页结果
     */
    @Operation(summary = "分页查询用户列表", description = "根据条件分页查询用户信息")
    @GetMapping(value = "/list")
    public Result<IPage<User>> queryPageList(User user,
                                           @RequestParam(name = "pageNo", defaultValue = "1") Integer pageNo,
                                           @RequestParam(name = "pageSize", defaultValue = "10") Integer pageSize,
                                           HttpServletRequest req) {
        try {
            Page<User> page = new Page<>(pageNo, pageSize);
            IPage<User> pageList = sysUserService.queryPageList(page, user);
            return Result.ok(pageList);
        } catch (Exception e) {
            log.error("查询用户列表失败", e);
            return Result.error("查询用户列表失败: " + e.getMessage());
        }
    }

    /**
     * 添加用户
     *
     * @param user 用户信息
     * @return 操作结果
     */
    @Operation(summary = "添加用户", description = "新增用户信息")
    @PostMapping(value = "/add")
    public Result<String> add(@RequestBody User user) {
        try {
            // 校验用户名唯一性
            if (!sysUserService.checkUsernameUnique(null, user.getUsername())) {
                return Result.error("用户名已存在");
            }
            
            // 校验手机号唯一性
            if (!sysUserService.checkPhoneUnique(null, user.getPhone())) {
                return Result.error("手机号已存在");
            }
            
            // 校验邮箱唯一性
            if (!sysUserService.checkEmailUnique(null, user.getEmail())) {
                return Result.error("邮箱已存在");
            }
            
            // 校验工号唯一性
            if (!sysUserService.checkWorkNoUnique(null, user.getWorkNo())) {
                return Result.error("工号已存在");
            }
            
            sysUserService.save(user);
            return Result.ok("添加成功");
        } catch (Exception e) {
            log.error("添加用户失败", e);
            return Result.error("添加失败: " + e.getMessage());
        }
    }

    /**
     * 编辑用户
     *
     * @param user 用户信息
     * @return 操作结果
     */
    @Operation(summary = "编辑用户", description = "修改用户信息")
    @PutMapping(value = "/edit")
    public Result<String> edit(@RequestBody User user) {
        try {
            // 校验用户名唯一性
            if (!sysUserService.checkUsernameUnique(user.getId(), user.getUsername())) {
                return Result.error("用户名已存在");
            }
            
            // 校验手机号唯一性
            if (!sysUserService.checkPhoneUnique(user.getId(), user.getPhone())) {
                return Result.error("手机号已存在");
            }
            
            // 校验邮箱唯一性
            if (!sysUserService.checkEmailUnique(user.getId(), user.getEmail())) {
                return Result.error("邮箱已存在");
            }
            
            // 校验工号唯一性
            if (!sysUserService.checkWorkNoUnique(user.getId(), user.getWorkNo())) {
                return Result.error("工号已存在");
            }
            
            sysUserService.updateById(user);
            return Result.ok("编辑成功");
        } catch (Exception e) {
            log.error("编辑用户失败", e);
            return Result.error("编辑失败: " + e.getMessage());
        }
    }

    /**
     * 删除用户
     *
     * @param id 用户ID
     * @return 操作结果
     */
    @Operation(summary = "删除用户", description = "通过ID删除用户")
    @DeleteMapping(value = "/delete")
    public Result<String> delete(@RequestParam(name = "id") String id) {
        try {
            boolean result = sysUserService.deleteUser(id);
            if (result) {
                return Result.ok("删除成功");
            } else {
                return Result.error("删除失败");
            }
        } catch (Exception e) {
            log.error("删除用户失败", e);
            return Result.error("删除失败: " + e.getMessage());
        }
    }

    /**
     * 批量删除用户
     *
     * @param ids 用户ID列表，逗号分隔
     * @return 操作结果
     */
    @Operation(summary = "批量删除用户", description = "批量删除用户信息")
    @DeleteMapping(value = "/deleteBatch")
    public Result<String> deleteBatch(@RequestParam(name = "ids") String ids) {
        try {
            boolean result = sysUserService.deleteBatchUsers(ids);
            if (result) {
                return Result.ok("批量删除成功");
            } else {
                return Result.error("批量删除失败");
            }
        } catch (Exception e) {
            log.error("批量删除用户失败", e);
            return Result.error("批量删除失败: " + e.getMessage());
        }
    }

    /**
     * 查询用户详情
     *
     * @param id 用户ID
     * @return 用户信息
     */
    @Operation(summary = "查询用户详情", description = "通过ID查询用户详细信息")
    @GetMapping(value = "/queryById")
    public Result<User> queryById(@RequestParam(name = "id") String id) {
        try {
            User user = sysUserService.getById(id);
            if (user == null) {
                return Result.error("用户不存在");
            }
            return Result.ok(user);
        } catch (Exception e) {
            log.error("查询用户详情失败", e);
            return Result.error("查询失败: " + e.getMessage());
        }
    }

    /**
     * 根据用户名查询用户
     *
     * @param username 用户名
     * @return 用户信息
     */
    @Operation(summary = "根据用户名查询用户", description = "通过用户名查询用户信息")
    @GetMapping(value = "/queryByName")
    public Result<User> queryByName(@RequestParam(name = "username") String username) {
        try {
            User user = sysUserService.getUserByName(username);
            if (user == null) {
                return Result.error("用户不存在");
            }
            return Result.ok(user);
        } catch (Exception e) {
            log.error("根据用户名查询用户失败", e);
            return Result.error("查询失败: " + e.getMessage());
        }
    }

    /**
     * 校验用户名唯一性
     *
     * @param id 用户ID
     * @param username 用户名
     * @return 校验结果
     */
    @Operation(summary = "校验用户名唯一性", description = "校验用户名是否已存在")
    @GetMapping(value = "/checkUsernameUnique")
    public Result<Boolean> checkUsernameUnique(@RequestParam(name = "id", required = false) String id,
                                             @RequestParam(name = "username") String username) {
        try {
            boolean unique = sysUserService.checkUsernameUnique(id, username);
            return Result.ok(unique);
        } catch (Exception e) {
            log.error("校验用户名唯一性失败", e);
            return Result.error("校验失败: " + e.getMessage());
        }
    }

    /**
     * 修改密码
     *
     * @param user 用户信息
     * @return 操作结果
     */
    @Operation(summary = "修改密码", description = "修改用户密码")
    @PutMapping(value = "/changePassword")
    public Result<String> changePassword(@RequestBody User user) {
        return sysUserService.changePassword(user);
    }

    /**
     * 冻结用户
     *
     * @param ids 用户ID列表
     * @return 操作结果
     */
    @Operation(summary = "冻结用户", description = "批量冻结用户账号")
    @PutMapping(value = "/frozenBatch")
    public Result<String> frozenBatch(@RequestParam(name = "ids") String ids) {
        return sysUserService.frozenBatch(ids);
    }

    /**
     * 解冻用户
     *
     * @param ids 用户ID列表
     * @return 操作结果
     */
    @Operation(summary = "解冻用户", description = "批量解冻用户账号")
    @PutMapping(value = "/unFrozenBatch")
    public Result<String> unFrozenBatch(@RequestParam(name = "ids") String ids) {
        return sysUserService.unFrozenBatch(ids);
    }

    /**
     * 批量查询用户
     *
     * @param ids 用户ID列表
     * @return 用户列表
     */
    @Operation(summary = "批量查询用户", description = "根据ID集合批量查询用户信息")
    @GetMapping(value = "/queryByIds")
    public Result<List<User>> queryByIds(@RequestParam(name = "ids") String ids) {
        try {
            String[] idArray = ids.split(",");
            List<String> idList = Arrays.asList(idArray);
            List<User> users = sysUserService.listByIds(idList);
            return Result.ok(users);
        } catch (Exception e) {
            log.error("批量查询用户失败", e);
            return Result.error("查询失败: " + e.getMessage());
        }
    }

    /**
     * 根据用户名批量查询
     *
     * @param usernames 用户名列表
     * @return 用户列表
     */
    @Operation(summary = "根据用户名批量查询", description = "根据用户名集合批量查询用户信息")
    @GetMapping(value = "/queryByNames")
    public Result<List<User>> queryByNames(@RequestParam(name = "usernames") String usernames) {
        try {
            String[] nameArray = usernames.split(",");
            QueryWrapper<User> queryWrapper = new QueryWrapper<>();
            queryWrapper.in("username", Arrays.asList(nameArray));
            queryWrapper.eq("deleted", 0);

            List<User> users = sysUserService.list(queryWrapper);
            return Result.ok(users);
        } catch (Exception e) {
            log.error("根据用户名批量查询失败", e);
            return Result.error("查询失败: " + e.getMessage());
        }
    }

    /**
     * 导出Excel
     *
     * @param user 查询条件
     * @param request HTTP请求
     * @return ModelAndView
     */
    @GetMapping("/exportXls")
    @Operation(summary = "导出Excel", description = "导出用户数据到Excel")
    public ModelAndView exportXls(User user, HttpServletRequest request) {
        // TODO: 实现Excel导出功能
        return new ModelAndView();
    }

    /**
     * 导入Excel
     *
     * @param request HTTP请求
     * @param response HTTP响应
     * @return 导入结果
     * @throws IOException IO异常
     */
    @PostMapping("/importExcel")
    @Operation(summary = "导入Excel", description = "通过Excel导入用户数据")
    public Result<String> importExcel(HttpServletRequest request, HttpServletResponse response) throws IOException {
        // TODO: 实现Excel导入功能
        return Result.ok("导入功能待实现");
    }
}
