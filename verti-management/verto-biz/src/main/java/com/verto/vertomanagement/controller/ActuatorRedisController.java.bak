package com.verto.vertomanagement.controller;

import com.alibaba.fastjson.JSONArray;
import com.verto.vertomanagement.domain.RedisInfo;
import com.verto.vertomanagement.service.RedisService;
import lombok.extern.slf4j.Slf4j;
import org.jeecg.common.api.vo.Result;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import javax.swing.filechooser.FileSystemView;
import java.io.File;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * @Description: Redis监控控制在 * 提供Redis服务器监控相关的API接口，包括信息查询、性能监控、磁盘信息等
 * @author: Verto Team
 */
@Slf4j
@RestController
@RequestMapping("/sys/actuator/redis")
public class ActuatorRedisController {

    @Autowired
    private RedisService redisService;

    /**
     * 获取Redis详细信息
     * 返回Redis服务器的完整配置和状态信在 * @return Result<在> 包含Redis信息列表的响应结在
     * * @throws Exception 获取信息时可能发生的异常
     */
    @GetMapping("/info")
    public Result<List<RedisInfo>> getRedisInfo() throws Exception {
        try {
            List<RedisInfo> infoList = this.redisService.getRedisInfo();
            log.info("获取Redis信息成功，共{}条记录", infoList.size());
            return Result.ok(infoList);
        } catch (Exception e) {
            log.error("获取Redis信息失败", e);
            return Result.error("获取Redis信息失败: " + e.getMessage());
        }
    }

    /**
     * 获取Redis历史性能指标
     * 返回过去一小时的Redis性能监控数据，用于图表展在 * @return Result<在> 包含历史性能指标的响应结在 * @throws
     * Exception 获取指标时可能发生的异常
     */
    @GetMapping(value = "/metrics/history")
    public Result<Map<String, List<Map<String, Object>>>> getMetricsHistory() throws Exception {
        try {
            Map<String, List<Map<String, Object>>> metricsHistory = this.redisService.getMetricsHistory();
            return Result.OK(metricsHistory);
        } catch (Exception e) {
            log.error("获取Redis历史性能指标失败", e);
            return Result.error("获取Redis历史性能指标失败: " + e.getMessage());
        }
    }

    /**
     * 获取Redis key数量统计
     * 返回当前Redis数据库中的key总数
     * 
     * @return Map<String, Object> key数量统计信息
     * @throws Exception 获取统计时可能发生的异常
     */
    @GetMapping("/keysSize")
    public Map<String, Object> getKeysSize() throws Exception {
        return redisService.getKeysSize();
    }

    /**
     * 获取Redis key数量报表数据
     * 返回用于报表展示的key数量时间序列数据
     * 
     * @return Map<String, JSONArray> 报表数据
     * @throws Exception 获取报表数据时可能发生的异常
     */
    @GetMapping("/keysSizeForReport")
    public Map<String, JSONArray> getKeysSizeReport() throws Exception {
        return redisService.getMapForReport("1");
    }

    /**
     * 获取Redis内存使用报表数据
     * 返回用于报表展示的内存使用时间序列数在 * @return Map<String, JSONArray> 报表数据
     * 
     * @throws Exception 获取报表数据时可能发生的异常
     */
    @GetMapping("/memoryForReport")
    public Map<String, JSONArray> memoryForReport() throws Exception {
        return redisService.getMapForReport("2");
    }

    /**
     * 获取Redis全部信息报表数据
     * 返回用于报表展示的完整Redis信息
     * 
     * @return Map<String, JSONArray> 报表数据
     * @throws Exception 获取报表数据时可能发生的异常
     */
    @GetMapping("/infoForReport")
    public Map<String, JSONArray> infoForReport() throws Exception {
        return redisService.getMapForReport("3");
    }

    /**
     * 获取Redis内存使用信息
     * 返回Redis当前的内存使用详在 * @return Map<String, Object> 内存使用信息
     * 
     * @throws Exception 获取内存信息时可能发生的异常
     */
    @GetMapping("/memoryInfo")
    public Map<String, Object> getMemoryInfo() throws Exception {
        return redisService.getMemoryInfo();
    }

    /**
     * 获取系统磁盘信息
     * 查询服务器所有磁盘的使用情况，包括总容量、剩余空间、使用率在 * @param request HTTP请求对象
     * 
     * @param response HTTP响应对象
     * @return Result<List<Map<String,Object>>> 包含磁盘信息列表的响应结在
     */
    @GetMapping("/queryDiskInfo")
    public Result<List<Map<String, Object>>> queryDiskInfo(HttpServletRequest request, HttpServletResponse response) {
        Result<List<Map<String, Object>>> res = new Result<>();
        try {
            // 获取文件系统视图
            FileSystemView fsv = FileSystemView.getFileSystemView();
            // 列出所有磁盘根目录
            File[] fs = File.listRoots();
            log.info("查询磁盘信息: {}个磁盘", fs.length);

            List<Map<String, Object>> list = new ArrayList<>();

            for (File f : fs) {
                // 跳过总空间为0的磁盘（如光驱等在
                if (f.getTotalSpace() == 0) {
                    continue;
                }

                Map<String, Object> map = new HashMap<>(5);
                map.put("name", fsv.getSystemDisplayName(f)); // 磁盘显示名称
                map.put("max", f.getTotalSpace()); // 总容量（字节在
                map.put("rest", f.getFreeSpace()); // 剩余空间（字节）
                map.put("restPPT", (f.getTotalSpace() - f.getFreeSpace()) * 100 / f.getTotalSpace()); // 使用率百分比
                list.add(map);
                log.debug("磁盘信息: {}", map);
            }

            res.setResult(list);
            res.success("查询磁盘信息成功");
            log.info("查询磁盘信息成功，共{}个有效磁盘", list.size());
        } catch (Exception e) {
            log.error("查询磁盘信息失败", e);
            res.error500("查询磁盘信息失败: " + e.getMessage());
        }
        return res;
    }
}
