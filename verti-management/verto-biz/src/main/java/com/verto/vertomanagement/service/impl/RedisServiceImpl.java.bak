package com.verto.vertomanagement.service.impl;

import cn.hutool.core.date.DateUtil;
import com.alibaba.fastjson.JSONArray;
import com.alibaba.fastjson.JSONObject;
import com.google.common.collect.Maps;
import com.verto.vertomanagement.domain.RedisInfo;
import com.verto.vertomanagement.exception.RedisConnectException;
import com.verto.vertomanagement.service.RedisService;
import lombok.extern.slf4j.Slf4j;
import org.jeecg.common.util.oConvertUtils;
import org.springframework.cglib.beans.BeanMap;
import org.springframework.data.redis.connection.RedisConnectionFactory;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;

import jakarta.annotation.Resource;
import java.util.*;

/**
 * @Description: Redis监控信息服务实现在 * 提供Redis服务器监控相关的业务逻辑实现，包括信息获取、性能监控在 * @author: Verto Team
 */
@Service("redisService")
@Slf4j
public class RedisServiceImpl implements RedisService {

    @Resource
    private RedisConnectionFactory redisConnectionFactory;

    /**
     * Redis信息类型常量
     */
    private static final String REDIS_MESSAGE = "3";

    /**
     * Redis性能指标记录存储
     * 用于存储历史性能数据，支持图表展在     */
    private static final Map<String, List<Map<String, Object>>> REDIS_METRICS = new HashMap<>(2);

    /**
     * 获取Redis详细信息
     * 通过Redis INFO命令获取服务器的详细信息
     * @return List<RedisInfo> Redis信息列表
     * @throws RedisConnectException Redis连接异常
     */
    @Override
    public List<RedisInfo> getRedisInfo() throws RedisConnectException {
        try {
            Properties info = redisConnectionFactory.getConnection().info();
            List<RedisInfo> infoList = new ArrayList<>();
            
            for (Map.Entry<Object, Object> entry : info.entrySet()) {
                RedisInfo redisInfo = new RedisInfo();
                redisInfo.setKey(oConvertUtils.getString(entry.getKey()));
                redisInfo.setValue(oConvertUtils.getString(entry.getValue()));
                infoList.add(redisInfo);
            }
            
            log.debug("获取Redis信息成功，共{}条记录", infoList.size());
            return infoList;
        } catch (Exception e) {
            log.error("获取Redis信息失败", e);
            throw new RedisConnectException("获取Redis信息失败: " + e.getMessage(), e);
        }
    }

    /**
     * 获取Redis key数量统计
     * 统计当前数据库中的key总数
     * @return Map<String, Object> key数量统计信息
     * @throws RedisConnectException Redis连接异常
     */
    @Override
    public Map<String, Object> getKeysSize() throws RedisConnectException {
        try {
            Long dbSize = redisConnectionFactory.getConnection().dbSize();
            Map<String, Object> map = new HashMap<>(5);
            map.put("create_time", System.currentTimeMillis());
            map.put("dbSize", dbSize);

            log.debug("获取Redis key数量: {}", map);
            return map;
        } catch (Exception e) {
            log.error("获取Redis key数量失败", e);
            throw new RedisConnectException("获取Redis key数量失败: " + e.getMessage(), e);
        }
    }

    /**
     * 获取Redis内存使用信息
     * 从Redis INFO命令结果中提取内存使用相关信在     * @return Map<String, Object> 内存使用信息
     * @throws RedisConnectException Redis连接异常
     */
    @Override
    public Map<String, Object> getMemoryInfo() throws RedisConnectException {
        try {
            Properties info = redisConnectionFactory.getConnection().info();
            Map<String, Object> map = null;
            
            for (Map.Entry<Object, Object> entry : info.entrySet()) {
                String key = oConvertUtils.getString(entry.getKey());
                if ("used_memory".equals(key)) {
                    map = new HashMap<>(5);
                    map.put("used_memory", entry.getValue());
                    map.put("create_time", System.currentTimeMillis());
                    break;
                }
            }
            
            log.debug("获取Redis内存信息: {}", map);
            return map;
        } catch (Exception e) {
            log.error("获取Redis内存信息失败", e);
            throw new RedisConnectException("获取Redis内存信息失败: " + e.getMessage(), e);
        }
    }

    /**
     * 获取报表需要的Redis信息
     * 根据不同类型返回相应的报表数在     * @param type 报表类型 (1:key数量, 2:内存信息, 3:全部信息)
     * @return Map<String, JSONArray> 报表数据
     * @throws RedisConnectException Redis连接异常
     */
    @Override
    public Map<String, JSONArray> getMapForReport(String type) throws RedisConnectException {
        Map<String, JSONArray> mapJson = new HashMap<>(5);
        JSONArray json = new JSONArray();

        // 返回完整的Redis信息
        if (REDIS_MESSAGE.equals(type)) {
            List<RedisInfo> redisInfo = getRedisInfo();
            for (RedisInfo info : redisInfo) {
                Map<String, Object> map = Maps.newHashMap();
                BeanMap beanMap = BeanMap.create(info);
                for (Object key : beanMap.keySet()) {
                    map.put(key + "", beanMap.get(key));
                }
                json.add(map);
            }
            mapJson.put("data", json);
            return mapJson;
        }

        // 生成时间序列数据（最在个时间点在        
        int length = 5;
        for (int i = 0; i < length; i++) {
            JSONObject jo = new JSONObject();
            Map<String, Object> map;
            
            if ("1".equals(type)) {
                // key数量报表
                map = getKeysSize();
                jo.put("value", map.get("dbSize"));
            } else {
                // 内存使用报表
                map = getMemoryInfo();
                Integer usedMemory = Integer.valueOf(map.get("used_memory").toString());
                jo.put("value", usedMemory / 1000); // 转换为KB
            }
            
            String createTime = DateUtil.formatTime(DateUtil.date((Long) map.get("create_time") - (4 - i) * 1000));
            jo.put("name", createTime);
            json.add(jo);
        }
        
        mapJson.put("data", json);
        return mapJson;
    }

    /**
     * 获取Redis历史性能指标
     * 返回存储的历史性能监控数据
     * @return Map<String, List<Map<String, Object>>> 历史性能指标数据
     */
    @Override
    public Map<String, List<Map<String, Object>>> getMetricsHistory() {
        return REDIS_METRICS;
    }

    /**
     * 定时记录Redis监控数据
     * 在0秒记录一次Redis的key数量和内存使用情在     * 保持最在0个数据点（即1小时的数据）
     * @throws RedisConnectException Redis连接异常
     */
    @Scheduled(fixedRate = 60000)
    public void recordCustomMetric() throws RedisConnectException {
        try {
            // 记录key数量数据
            List<Map<String, Object>> dbSizeList = REDIS_METRICS.computeIfAbsent("dbSize", k -> new ArrayList<>());
            if (dbSizeList.size() > 60) {
                dbSizeList.remove(0); // 移除最旧的数据
            }
            dbSizeList.add(getKeysSize());

            // 记录内存使用数据
            List<Map<String, Object>> memoryList = REDIS_METRICS.computeIfAbsent("memory", k -> new ArrayList<>());
            if (memoryList.size() > 60) {
                memoryList.remove(0); // 移除最旧的数据
            }
            memoryList.add(getMemoryInfo());

            log.debug("Redis监控数据记录成功，dbSize数据在 {}, memory数据在 {}", 
                     dbSizeList.size(), memoryList.size());
        } catch (Exception e) {
            log.error("记录Redis监控数据失败", e);
        }
    }
}
