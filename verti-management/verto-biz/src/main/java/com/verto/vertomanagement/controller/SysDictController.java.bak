package com.verto.vertomanagement.controller;

import com.baomidou.mybatisplus.core.conditions.query.LambdaQueryWrapper;
import com.baomidou.mybatisplus.core.conditions.query.QueryWrapper;
import com.baomidou.mybatisplus.core.metadata.IPage;
import com.baomidou.mybatisplus.extension.plugins.pagination.Page;
import com.verto.vertomanagement.common.api.vo.Result;
import com.verto.vertomanagement.entity.SysDict;
import com.verto.vertomanagement.entity.SysDictItem;
import com.verto.vertomanagement.service.ISysDictItemService;
import com.verto.vertomanagement.service.ISysDictService;
import com.verto.vertomanagement.vo.DictModel;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.util.StringUtils;
import org.springframework.web.bind.annotation.*;

import jakarta.servlet.http.HttpServletRequest;
import java.util.Arrays;
import java.util.Date;
import java.util.List;
import java.util.Map;

/**
 * 系统字典控制器
 * 提供字典数据的管理接口
 * 
 * @author Verto
 * @since 2024-01-01
 */
@Tag(name = "系统字典管理")
@RestController
@RequestMapping("/sys/dict")
@Slf4j
public class SysDictController {

    @Autowired
    private ISysDictService sysDictService;

    @Autowired
    private ISysDictItemService sysDictItemService;

    /**
     * 分页查询字典列表
     * @param sysDict 查询条件
     * @param pageNo 页码
     * @param pageSize 页大小
     * @param keywords 关键词
     * @param req 请求对象
     * @return 分页结果
     */
    @Operation(summary = "分页查询字典列表")
    @GetMapping("/list")
    public Result<IPage<SysDict>> queryPageList(
            SysDict sysDict,
            @RequestParam(name = "pageNo", defaultValue = "1") Integer pageNo,
            @RequestParam(name = "pageSize", defaultValue = "10") Integer pageSize,
            @RequestParam(name = "keywords", required = false) String keywords,
            HttpServletRequest req) {
        
        log.info("分页查询字典列表，页码：{}，页大小：{}，关键字：{}", pageNo, pageSize, keywords);
        
        QueryWrapper<SysDict> queryWrapper = new QueryWrapper<>();
        
        // 构建查询条件
        if (StringUtils.hasText(sysDict.getDictName())) {
            queryWrapper.like("dict_name", sysDict.getDictName());
        }
        if (StringUtils.hasText(sysDict.getDictCode())) {
            queryWrapper.like("dict_code", sysDict.getDictCode());
        }
        if (StringUtils.hasText(sysDict.getType())) {
            queryWrapper.eq("type", sysDict.getType());
        }
        
        // 关键字模糊查询
        if (StringUtils.hasText(keywords)) {
            queryWrapper.and(i -> i.like("dict_code", keywords).or().like("dict_name", keywords));
        }
        
        // 排除已删除的数据
        queryWrapper.eq("del_flag", 0);
        queryWrapper.orderByDesc("create_time");
        
        Page<SysDict> page = new Page<>(pageNo, pageSize);
        IPage<SysDict> pageList = sysDictService.page(page, queryWrapper);
        
        return Result.ok(pageList);
    }

    /**
     * 新增字典
     * @param sysDict 字典对象
     * @return 操作结果
     */
    @Operation(summary = "新增字典")
    @PostMapping("/add")
    public Result<String> add(@RequestBody SysDict sysDict) {
        log.info("新增字典，字典编码：{}", sysDict.getDictCode());
        
        // 检查字典编码是否重复
        LambdaQueryWrapper<SysDict> queryWrapper = new LambdaQueryWrapper<>();
        queryWrapper.eq(SysDict::getDictCode, sysDict.getDictCode());
        queryWrapper.eq(SysDict::getDelFlag, 0);
        long count = sysDictService.count(queryWrapper);
        if (count > 0) {
            return Result.error("字典编码已存在！");
        }
        
        sysDict.setCreateTime(new Date());
        sysDict.setUpdateTime(new Date());
        sysDict.setDelFlag(0);
        
        boolean success = sysDictService.save(sysDict);
        if (success) {
            return Result.ok("添加成功");
        } else {
            return Result.error("添加失败");
        }
    }

    /**
     * 编辑字典
     * @param sysDict 字典对象
     * @return 操作结果
     */
    @Operation(summary = "编辑字典")
    @PutMapping("/edit")
    public Result<String> edit(@RequestBody SysDict sysDict) {
        log.info("编辑字典，字典ID：{}", sysDict.getId());
        
        // 检查字典编码是否重复（排除自己）
        LambdaQueryWrapper<SysDict> queryWrapper = new LambdaQueryWrapper<>();
        queryWrapper.eq(SysDict::getDictCode, sysDict.getDictCode());
        queryWrapper.eq(SysDict::getDelFlag, 0);
        queryWrapper.ne(SysDict::getId, sysDict.getId());
        long count = sysDictService.count(queryWrapper);
        if (count > 0) {
            return Result.error("字典编码已存在！");
        }
        
        sysDict.setUpdateTime(new Date());
        boolean success = sysDictService.updateById(sysDict);
        if (success) {
            return Result.ok("编辑成功");
        } else {
            return Result.error("编辑失败");
        }
    }

    /**
     * 通过ID查询字典
     * @param id 字典ID
     * @return 字典对象
     */
    @Operation(summary = "通过ID查询字典")
    @GetMapping("/queryById")
    public Result<SysDict> queryById(@RequestParam(name = "id", required = true) String id) {
        log.info("通过ID查询字典，ID：{}", id);
        SysDict sysDict = sysDictService.getById(id);
        return Result.ok(sysDict);
    }

    /**
     * 删除字典
     * @param id 字典ID
     * @return 操作结果
     */
    @Operation(summary = "删除字典")
    @DeleteMapping("/delete")
    public Result<String> delete(@RequestParam(name = "id", required = true) String id) {
        log.info("删除字典，ID：{}", id);
        
        // 逻辑删除
        sysDictService.updateDictDelFlag(1, id);
        return Result.ok("删除成功");
    }

    /**
     * 批量删除字典
     * @param ids 字典ID列表
     * @return 操作结果
     */
    @Operation(summary = "批量删除字典")
    @DeleteMapping("/deleteBatch")
    public Result<String> deleteBatch(@RequestParam(name = "ids", required = true) String ids) {
        log.info("批量删除字典，IDs：{}", ids);
        
        String[] idArray = ids.split(",");
        for (String id : idArray) {
            sysDictService.updateDictDelFlag(1, id);
        }
        return Result.ok("批量删除成功");
    }

    /**
     * 获取字典数据
     * @param dictCode 字典编码
     * @return 字典项列表
     */
    @Operation(summary = "获取字典数据")
    @GetMapping("/getDictItems/{dictCode}")
    public Result<List<DictModel>> getDictItems(@PathVariable("dictCode") String dictCode) {
        log.info("获取字典数据，字典编码：{}", dictCode);
        
        List<DictModel> dictItems = sysDictService.queryDictItemsByCode(dictCode);
        return Result.ok(dictItems);
    }

    /**
     * 获取字典文本
     * @param dictCode 字典编码
     * @param key 字典键值
     * @return 字典文本
     */
    @Operation(summary = "获取字典文本")
    @GetMapping("/getDictText/{dictCode}/{key}")
    public Result<String> getDictText(@PathVariable("dictCode") String dictCode, @PathVariable("key") String key) {
        log.info("获取字典文本，字典编码：{}，键值：{}", dictCode, key);
        
        String text = sysDictService.queryDictTextByKey(dictCode, key);
        return Result.ok(text);
    }

    /**
     * 获取全部字典数据
     * @return 所有字典数据
     */
    @Operation(summary = "获取全部字典数据")
    @GetMapping("/queryAllDictItems")
    public Result<Map<String, List<DictModel>>> queryAllDictItems() {
        log.info("获取全部字典数据");
        
        Map<String, List<DictModel>> allDictItems = sysDictService.queryAllDictItems();
        return Result.ok(allDictItems);
    }

    /**
     * 刷新字典缓存
     * @return 操作结果
     */
    @Operation(summary = "刷新字典缓存")
    @GetMapping("/refleshCache")
    public Result<String> refleshCache() {
        log.info("刷新字典缓存");
        
        sysDictService.refreshCache();
        return Result.ok("刷新缓存成功");
    }

    /**
     * 查询删除列表
     * @return 已删除的字典列表
     */
    @Operation(summary = "查询删除列表")
    @GetMapping("/deleteList")
    public Result<List<SysDict>> deleteList() {
        log.info("查询删除列表");
        
        List<SysDict> deleteList = sysDictService.queryDeleteList();
        return Result.ok(deleteList);
    }

    /**
     * 物理删除字典
     * @param id 字典ID
     * @return 操作结果
     */
    @Operation(summary = "物理删除字典")
    @DeleteMapping("/deletePhysic/{id}")
    public Result<String> deletePhysic(@PathVariable("id") String id) {
        log.info("物理删除字典，ID：{}", id);
        
        sysDictService.deleteOneDictPhysically(id);
        return Result.ok("物理删除成功");
    }

    /**
     * 还原字典
     * @param id 字典ID
     * @return 操作结果
     */
    @Operation(summary = "还原字典")
    @PutMapping("/back/{id}")
    public Result<String> back(@PathVariable("id") String id) {
        log.info("还原字典，ID：{}", id);
        
        sysDictService.updateDictDelFlag(0, id);
        return Result.ok("还原成功");
    }

    /**
     * 批量还原字典
     * @param ids 字典ID列表
     * @return 操作结果
     */
    @Operation(summary = "批量还原字典")
    @PutMapping("/putRecycleBin")
    public Result<String> putRecycleBin(@RequestParam("ids") String ids) {
        log.info("批量还原字典，IDs：{}", ids);
        
        List<String> idList = Arrays.asList(ids.split(","));
        sysDictService.revertLogicDeleted(idList);
        return Result.ok("批量还原成功");
    }

    /**
     * 批量彻底删除字典
     * @param ids 字典ID列表
     * @return 操作结果
     */
    @Operation(summary = "批量彻底删除字典")
    @DeleteMapping("/deleteRecycleBin")
    public Result<String> deleteRecycleBin(@RequestParam("ids") String ids) {
        log.info("批量彻底删除字典，IDs：{}", ids);
        
        List<String> idList = Arrays.asList(ids.split(","));
        sysDictService.removeLogicDeleted(idList);
        return Result.ok("批量彻底删除成功");
    }
}
