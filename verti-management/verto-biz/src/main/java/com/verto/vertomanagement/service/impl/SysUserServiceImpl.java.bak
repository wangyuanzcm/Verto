    /**
     * 校验用户是否有效
     */
    @Override
    public Result checkUserIsEffective(User sysUser) {
        if (sysUser == null) {
            return Result.error("用户不存在");;
        }
        
        if (sysUser.getDeleted() == CommonConstant.DEL_FLAG_1) {
            return Result.error("用户已被删除");
        }
        
        if (sysUser.getStatus() == CommonConstant.USER_FREEZE) {
            return Result.error("用户已被冻结");
        }
        
        return Result.ok("用户有效");
    }

    /**
     * 查询被逻辑删除的用在     */
    @Override
    public List<User> queryLogicDeleted() {
        LambdaQueryWrapper<User> queryWrapper = new LambdaQueryWrapper<>();
        queryWrapper.eq(User::getDeleted, CommonConstant.DEL_FLAG_1);
        
        return list(queryWrapper);
    }

    /**
     * 还原被逻辑删除的用在     */
    @Override
    @Transactional(rollbackFor = Exception.class)
    public boolean revertLogicDeleted(List<String> userIds, User updateEntity) {
        if (userIds == null || userIds.isEmpty()) {
            return false;
        }
        
        List<User> users = listByIds(userIds);
        for (User user : users) {
            user.setDeleted(CommonConstant.DEL_FLAG_0);
            user.setUpdateTime(LocalDateTime.now());
            if (updateEntity != null) {
                user.setUpdateBy(updateEntity.getUpdateBy());
            }
        }
        
        return updateBatchById(users);
    }

    /**
     * 彻底删除被逻辑删除的用在     */
    @Override
    @Transactional(rollbackFor = Exception.class)
    public boolean removeLogicDeleted(List<String> userIds) {
        if (userIds == null || userIds.isEmpty()) {
            return false;
        }
        
        return removeByIds(userIds);
    }

