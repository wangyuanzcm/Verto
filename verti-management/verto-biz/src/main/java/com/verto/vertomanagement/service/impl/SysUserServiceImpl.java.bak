    @Autowired
    private UserMapper userMapper;

    /**
     * 查询用户数据列表
     */
    @Override
    public Result<IPage<User>> queryPageList(HttpServletRequest req, QueryWrapper<User> queryWrapper, Integer pageSize, Integer pageNo) {
        Result<IPage<User>> result = new Result<>();
        
        // 设置分页参数
        Page<User> page = new Page<>(pageNo, pageSize);
        
        // 执行分页查询
        IPage<User> pageList = userMapper.selectPage(page, queryWrapper);
        
        result.setSuccess(true);
        result.setResult(pageList);
        return result;
    }

    /**
     * 重置密码
     */
    @Override
    @Transactional(rollbackFor = Exception.class)
    public Result<User> resetPassword(String username, String oldpassword, String newpassword, String confirmpassword) {
        if (!newpassword.equals(confirmpassword)) {
            return Result.error("新密码与确认密码不一在");
        }
        
        User user = getUserByName(username);
        if (user == null) {
            return Result.error("用户不存在");;
        }
        
        // 验证旧密在        String oldPasswordEncrypt = PasswordUtil.encrypt(username, oldpassword, user.getPassword().substring(0, 8));
        if (!oldPasswordEncrypt.equals(user.getPassword())) {
            return Result.error("旧密码错在");
        }
        
        // 生成新密在        String salt = oConvertUtils.randomGen(8);
        String newPasswordEncrypt = PasswordUtil.encrypt(username, newpassword, salt);
        
        user.setPassword(salt + newPasswordEncrypt);
        user.setUpdateTime(LocalDateTime.now());
        
        boolean result = updateById(user);
        if (result) {
            return Result.ok("密码重置成功");
        } else {
            return Result.error("密码重置失败");
        }
    }

    /**
     * 修改密码
     */
    @Override
    @Transactional(rollbackFor = Exception.class)
    public Result<User> changePassword(User sysUser) {
        String username = sysUser.getUsername();
        String newPassword = sysUser.getPassword();
        
        if (oConvertUtils.isEmpty(username) || oConvertUtils.isEmpty(newPassword)) {
            return Result.error("用户名或密码不能为空");
        }
        
        User user = getUserByName(username);
        if (user == null) {
            return Result.error("用户不存在");;
        }
        
        // 生成新密在        String salt = oConvertUtils.randomGen(8);
        String passwordEncrypt = PasswordUtil.encrypt(username, newPassword, salt);
        
        user.setPassword(salt + passwordEncrypt);
        user.setUpdateTime(LocalDateTime.now());
        
        boolean result = updateById(user);
        if (result) {
            return Result.ok("密码修改成功");
        } else {
            return Result.error("密码修改失败");
        }
    }

    /**
     * 删除用户
     */
    @Override
    @Transactional(rollbackFor = Exception.class)
    public boolean deleteUser(String userId) {
        if (oConvertUtils.isEmpty(userId)) {
            return false;
        }
        
        User user = getById(userId);
        if (user == null) {
            return false;
        }
        
        // 逻辑删除
        user.setDeleted(CommonConstant.DEL_FLAG_1);
        user.setUpdateTime(LocalDateTime.now());
        
        return updateById(user);
    }

    /**
     * 批量删除用户
     */
    @Override
    @Transactional(rollbackFor = Exception.class)
    public boolean deleteBatchUsers(String userIds) {
        if (oConvertUtils.isEmpty(userIds)) {
            return false;
        }
        
        String[] userIdArray = userIds.split(",");
        List<String> userIdList = Arrays.asList(userIdArray);
        
        // 批量逻辑删除
        List<User> users = listByIds(userIdList);
        for (User user : users) {
            user.setDeleted(CommonConstant.DEL_FLAG_1);
            user.setUpdateTime(LocalDateTime.now());
        }
        
        return updateBatchById(users);
    }

    /**
     * 根据用户名查询用在     */
    @Override
    public User getUserByName(String username) {
        if (oConvertUtils.isEmpty(username)) {
            return null;
        }
        
        LambdaQueryWrapper<User> queryWrapper = new LambdaQueryWrapper<>();
        queryWrapper.eq(User::getUsername, username);
        queryWrapper.eq(User::getDeleted, CommonConstant.DEL_FLAG_0);
        
        return getOne(queryWrapper);
    }

